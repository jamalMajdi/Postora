{
  "name": "postora",
  "version": "1.0.0",
  "private": true,
  "description": "Postora — professional Telegram publishing system (Bot + Mini App)",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:server": "npm run dev --workspace @postora/server",
    "dev:miniapp": "npm run dev --workspace @postora/miniapp",
    "build": "npm run build --workspace @postora/miniapp",
    "migrate": "node scripts/migrate.js up",
    "migrate:down": "node scripts/migrate.js down",
    "migrate:create": "node-pg-migrate create --migrations-dir apps/server/src/db/migrations --migration-file-language js",
    "test": "npm run test --workspace @postora/markdown-engine && npm run test --workspace @postora/shared && npm run test --workspace @postora/server",
    "test:engine": "npm run test --workspace @postora/markdown-engine",
    "test:server": "npm run test --workspace @postora/server",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,jsx,json,md,css}\"",
    "db:setup": "bash scripts/ensure-db.sh",
    "verify": "bash scripts/verify.sh"
  },
  "devDependencies": {
    "eslint": "9.18.0",
    "eslint-plugin-react": "^7.37.5",
    "node-pg-migrate": "7.9.0",
    "prettier": "3.4.2"
  }
}
