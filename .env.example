# ============================================================
# Postora — Environment template
# انسخ هذا الملف إلى .env ثم عبّئ القيم.
# لا تضع أي سر حقيقي في هذا الملف (هو مُتعقَّب في Git).
# ============================================================

# ---------- Core ----------
# development | test | production
NODE_ENV=development
PORT=3000

# ---------- Telegram Bot ----------
# ضع التوكن الذي أنشأته من BotFather. لا تشاركه مع أي أحد ولا ترفعه إلى Git.
BOT_TOKEN=YOUR_NEW_BOT_TOKEN
BOT_USERNAME=Postora_1bot

# polling | webhook   (polling للتطوير المحلي، webhook للإنتاج)
BOT_MODE=polling
# يُستخدم فقط عند BOT_MODE=webhook
# رابط عام يجب أن ينتهي بـ /telegram/webhook
WEBHOOK_URL=
# سلسلة عشوائية طويلة تُقارن في كل طلب webhook (إلزامية في وضع webhook)
WEBHOOK_SECRET=

# ---------- Database ----------
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postora:postora_dev_pw@127.0.0.1:5432/postora_dev
TEST_DATABASE_URL=postgresql://postora:postora_dev_pw@127.0.0.1:5432/postora_test
# عدد اتصالات pool
DB_POOL_MAX=10

# ---------- Auth (Mini App) ----------
# سر توقيع JWT الداخلي. يجب أن يكون ≥ 32 محرفًا عشوائيًا.
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
# مدة صلاحية الجلسة بالثواني (افتراضي ساعتان)
JWT_TTL_SECONDS=7200
# أقصى عمر مقبول لـ initData بالثواني (افتراضي 24 ساعة)
INIT_DATA_MAX_AGE_SECONDS=86400

# ---------- Mini App ----------
# أصول مسموحة للـ CORS، مفصولة بفواصل
CORS_ORIGINS=http://localhost:5173
# عنوان الواجهة العامة (يُستخدم في رسائل البوت)
MINIAPP_URL=

# ---------- Limits ----------
MAX_UPLOAD_BYTES=262144
MAX_CONTENT_CHARS=100000
MAX_PUBLISH_MESSAGES=40

# ---------- Logging ----------
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ---------- Testing only ----------
# ⚠️ تحذير: لا تفتح هذا السطر أبدًا إلا للاختبار الآلي المحلي.
# إن وجّهته إلى خادم وهمي فسيتوقف البوت عن استقبال تحديثات تلجرام الحقيقي
# **بلا أي رسالة خطأ** — يبدو سليمًا وهو معطّل. اتركه معلّقًا دائمًا في التشغيل العادي.
# TELEGRAM_API_BASE_URL=
# مفتاح اختبار لتوقيع initData محليًا (لا تستخدمه في الإنتاج)
# TEST_BOT_TOKEN_WITH_COLON=123456:TEST_ONLY_TOKEN_NOT_REAL
